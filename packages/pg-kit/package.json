{
  "name": "@factory/pg-kit",
  "version": "0.1.1",
  "description": "Shared Playgama-compliant runtime foundation for factory games (Bridge lifecycle, saves, ads, audio/pause matrix, i18n, input, layout, testing mock).",
  "private": true,
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./phaser": { "types": "./dist/phaser/index.d.ts", "import": "./dist/phaser/index.js" },
    "./testing": { "types": "./dist/testing/index.d.ts", "import": "./dist/testing/index.js" }
  },
  "files": ["dist", "CHANGELOG.md", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@playgama/bridge": "2.4.1",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
