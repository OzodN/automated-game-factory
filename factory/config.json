{
  "humanLanguage": "auto",
  "maxAttempts": 3,
  "concurrency": 3,
  "maxActiveAgents": 4,
  "approvalTtlHours": 24,
  "draftTokenTtlHours": 2,
  "packageManager": "corepack pnpm",
  "lockStaleMs": 120000,
  "infraRetriesPerAttempt": 2,
  "release": {
    "maxBytes": 26214400,
    "maxFiles": 250,
    "maxFileBytes": 10485760
  },
  "models": {
    "note": "Pinned subagent models (human decision 2026-11-13). Single source of truth: apply with `node factory/cli/gen-agent-models.mjs`, check with `factory doctor`. Never pass model/effort on an Agent call. The main session (game-orchestrator) is not pinned; its default is in .claude/settings.json.",
    "pins": {
      "game-developer": { "model": "claude-sonnet-5-5", "effort": "high" },
      "platform-engineer": { "model": "claude-sonnet-5-5", "effort": "high" },
      "qa-engineer": { "model": "claude-sonnet-5-5", "effort": "high" },
      "asset-producer": { "model": "claude-sonnet-5-5", "effort": "high" },
      "release-manager": { "model": "claude-sonnet-5-5", "effort": "high" },
      "market-analyst": { "model": "claude-sonnet-5-5", "effort": "high" },
      "tech-architect": { "model": "claude-opus-5-5", "effort": "medium" },
      "code-reviewer": { "model": "claude-opus-5-5", "effort": "medium" },
      "game-designer": { "model": "claude-opus-5-5", "effort": "medium" }
    },
    "retry": {
      "model": "claude-opus-5-5",
      "effort": "medium",
      "agents": ["game-developer", "platform-engineer", "qa-engineer", "asset-producer"]
    },
    "unpinned": ["game-orchestrator"]
  },
  "maintenance": {
    "note": "Commands that `factory maint merge` runs in the fx worktree (FACTORY_* env cleared) before it merges the branch into main.",
    "verify": ["node --test factory/cli/test/*.test.mjs"]
  }
}
